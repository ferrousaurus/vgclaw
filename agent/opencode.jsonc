{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "pokemon-data": {
      "type": "local",
      "command": ["bun", "run", "../src/mcp.ts"],
    },
  },
  "agent": {
    "build": {
      "disable": true,
    },
    "plan": {
      "permission": {
        "bash": {
          "jq *": "allow",
        },
        "edit": {
          "teams/**.md": "allow",
        },
      },
    },
  },
}
