{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "pokemon-data": {
        "type": "local",
        "cwd": "../src",
        "command": [
          "nub",
          "run",
          "mcp"
        ],
      },
    },
  },
  "agents": {
    "build": {
      "disabled": true,
    },
    "plan": {
      "permissions": [
        {
          "action": "shell",
          "resource": "jq *",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "teams/**.md",
          "effect": "allow"
        }
      ]
    },
  },
}
